<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- No domain-config overrides: every domain falls through to base-config, so this
         applies globally, including to osmdroid tile hosts and Firebase/Google APIs. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
