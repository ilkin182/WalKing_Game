<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firebase Auth, osmdroid tile downloads, and the (unused-elsewhere) Retrofit/Firebase AI stack -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Core feature: GPS hex-stomping. Requested at runtime from MapScreen, only after login. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- osmdroid checks connectivity before deciding to hit the tile network vs. its local cache -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Step-counter sensor access (API 29+ runtime permission), requested alongside location -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- StepCounterService is a foreground service (type="health") so counting survives backgrounding -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- LocationTrackingService is a foreground service (type="location") so GPS tracking and hex
         stomping keep working while the app is backgrounded or the screen is locked -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Foreground service notification (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <!-- singleTask so a tapped race invitation is delivered to the running app through
             onNewIntent instead of stacking a second copy of the map on top of the first. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Race invitations under the app's own scheme: walkinggame://race/ABC123?... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="walkinggame"
                    android:host="race" />
            </intent-filter>

            <!-- The shared form: https://walkinggame.app/r/ABC123?...
                 Not autoVerify'd - App Links verification needs an assetlinks.json served from that
                 domain, and there is no domain yet. Without it Android offers the app in the
                 disambiguation sheet rather than opening it straight away, which still works and is
                 honest about the app not owning the address. Turn on autoVerify the day the domain
                 is real. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="walkinggame.app"
                    android:pathPrefix="/r/" />
            </intent-filter>
        </activity>

        <service
            android:name=".steps.StepCounterService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="health" />

        <service
            android:name=".location.LocationTrackingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
